# Keep source and documentation diffs stable across Windows and Unix clients.
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Runtime and media artifacts are binary when they appear in historical data.
*.sqlite binary
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.bundle binary
